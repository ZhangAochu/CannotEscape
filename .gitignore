# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Aa]ssets/[Aa]sset[Ss]tore*
*.autosave

# ProjectSettings（保留所有关键配置）
/[Pp]rojectSettings/*.meta
/[Pp]rojectSettings/*.tmp
!/[Pp]rojectSettings/*.asset
!/[Pp]rojectSettings/*.txt

# Packages（保留依赖清单）
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# IDE
.vs/
.idea/
.vscode/
.idea_modules/
*.csproj
*.sln
*.userprefs
*.iml

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
*.stacktrace

# Unity 2020+ 新增的缓存目录
/[Gg]enerated/

# Unity 自动保存文件
*.autosave.*

# Unity 崩溃报告
[Cc]rash[Rr]eports/

# 本地调试配置
*.private.asset