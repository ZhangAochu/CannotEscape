  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: SickroomNaratage
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u662F\uFF0C\u662F\u8C01\u5728\u8BB2\u8BDD?"
  - "\u8BF6?\u6211\u2026\u2026"
  - "\u6211\u731B\u7136\u7741\u5F00\u773C\uFF0C\u773C\u524D\u662F\u5DE5\u4F5C\u4E86\u4E0D\u77E5\u9053\u591A\u5C11\u5E74\u5934\u7684\u9876\u706F\uFF0C\u65E9\u5DF2\u53D1\u9EC4\u7684\u706F\u7F69\u91CC\u900F\u51FA\u5C11\u91CF\u5149\u7EBF\uFF0C\u52C9\u5F3A\u591F\u7167\u4EAE\u4E0D\u5927\u7684\u75C5\u623F\u3002"
  - "\u8FD9\u51E0\u5929\uFF0C\u4E0D\uFF0C\u53EF\u80FD\u662F\u51E0\u4E2A\u6708\u5427\uFF0C\u6216\u8005\u66F4\u4E45\uFF0C\u6BCF\u4E00\u65E5\u9192\u6765\u90FD\u662F\u540C\u6837\u7684\u666F\u8272\u3002"
  - "\u53E6\u4E00\u5F20\u75C5\u5E8A\u4E0A\u662F\u6211\u7684\u4E3B\u6CBB\u533B\u751F\u3002"
  - "\u662F\u7684\uFF0C\u8FD9\u91CC\u662F\u4E00\u95F4\u7CBE\u795E\u75C5\u9662\uFF0C\u5982\u679C\u5916\u9762\u7684\u5BB6\u4F19\u8BF4\u7684\u662F\u5B9E\u8BDD\uFF0C\u4E0D\u8FC7\u6211\u7684\u4E3B\u6CBB\u533B\u751F\u4E5F\u662F\u8FD9\u4E48\u8BF4\u7684\u3002\u611F\u89C9\u4ED6\u662F\u4E00\u4E2A\u53EF\u9760\u7684\u4EBA\uFF0C\u5927\u6982\uFF0C\u4ED6\u5BF9\u6211\u633A\u6E29\u548C\u7684\u3002"
  - "\u6211\u8BB0\u4E0D\u8D77\u6765\u4EE5\u524D\u7684\u4E8B\u60C5\uFF0C\u800C\u4E14\u8FC7\u4E00\u6BB5\u65F6\u95F4\u5C31\u4F1A\u5927\u8111\u65AD\u7247\uFF0C\u90A3\u4E00\u6BB5\u65F6\u95F4\u7684\u4E8B\u60C5\u8FC7\u540E\u6211\u6839\u672C\u8BB0\u4E0D\u8D77\u6765\u3002\u8FD9\u4E48\u770B\u6765\u6211\u786E\u5B9E\u6709\u7CBE\u795E\u75C5\u2026\u2026\u5C31\u5F53\u8FD9\u91CC\u662F\u7CBE\u795E\u75C5\u9662\u5427\uFF09"
