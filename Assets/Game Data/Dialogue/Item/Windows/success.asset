  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: success
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u73BB\u7483\u540E\u9762\u7684\u94C1\u7F51\u5DF2\u7ECF\u9508\u8FF9\u6591\u6591\uFF0C\u770B\u8D77\u6765\u6447\u6447\u6B32\u5760\u3002"
  - "\u6211\u9AD8\u9AD8\u4E3E\u8D77\u5B89\u5168\u9524\uFF0C\u7784\u51C6\u8FDE\u63A5\u5904\uFF0C\u4F7F\u51FA\u5168\u8EAB\u529B\u6C14\u7838\u4E86\u4E0B\u53BB\u3002\u73BB\u7483\u788E\u88C2\u7684\u5C16\u9510\u58F0\u54CD\u77AC\u95F4\u5212\u7834\u4E86\u5BC2\u9759\uFF0C\u94C1\u7F51\u4E5F\u88AB\u7838\u5F00\u4E86\u4E00\u4E2A\u53E3\u5B50\uFF0C\u51B7\u98CE\u547C\u547C\u5730\u704C\u4E86\u8FDB\u6765\uFF0C\u5E26\u7740\u4E00\u80A1\u6F6E\u6E7F\u7684\u9709\u5473\u3002"
  - "\u6211\u6B63\u8981\u722C\u51FA\u53BB\uFF0C\u7A81\u7136\uFF0C\u4E00\u5F20\u60E8\u767D\u7684\u8138\u731B\u5730\u8D34\u5728\u7A97\u5916\uFF01"
  - "\u662F\u4E2A\u62A4\u58EB\uFF0C\u5979\u7684\u53CC\u773C\u7A7A\u6D1E\u65E0\u795E\uFF0C\u5B9B\u5982\u65E0\u5C3D\u7684\u6DF1\u6E0A\uFF0C\u5634\u89D2\u626F\u51FA\u4E00\u62B9\u50F5\u786C\u7684\u7B11\u5BB9\uFF0C\u5C31\u50CF\u662F\u4ECE\u5669\u68A6\u4E2D\u722C\u51FA\u6765\u7684\u5E7D\u7075\u3002\u5979\u7684\u5236\u670D\u5DF2\u7ECF\u6CDB\u9EC4\uFF0C\u8896\u53E3\u4E0A\u6CBE\u7740\u6697\u7EA2\u8272\u7684\u6C61\u6E0D\uFF0C\u624B\u91CC\u7D27\u63E1\u7740\u4E00\u628A\u751F\u9508\u7684\u6CE8\u5C04\u5668\uFF0C\u9488\u5934\u5728\u660F\u6697\u7684\u5149\u7EBF\u4E0B\u95EA\u70C1\u7740\u51B0\u51B7\u7684\u5BD2\u5149\u3002\u6211\u5413\u5F97\u8FDE\u8FDE\u540E\u9000\uFF0C\u5B89\u5168\u9524\u5DEE\u70B9\u4ECE\u624B\u4E2D\u6ED1\u843D\uFF0C\u5FC3\u810F\u8DF3\u5F97\u50CF\u6572\u8D77\u4E86\u6025\u4FC3\u7684\u6218\u9F13\u3002"
  - " \u201C\u75C5\u4EBA\u2026\u2026 \u4E0D\u80FD\u79BB\u5F00\u2026\u2026\u201D \u5979\u7684\u58F0\u97F3\u6C99\u54D1\u5F97\u5982\u540C\u4ECE\u5589\u5499\u6DF1\u5904\u6324\u51FA\u6765\u7684\uFF0C\u5E26\u7740\u4E00\u79CD\u8BE1\u5F02\u7684\u8282\u594F\u611F\uFF0C\u201C\u8BB0\u5FC6\u2026\u2026
    \u4F1A\u5BB3\u4E86\u4F60\u2026\u2026\u201D"
  - ...................
