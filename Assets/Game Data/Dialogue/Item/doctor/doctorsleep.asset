  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: doctorsleep
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u6211\u8F7B\u8F7B\u5730\u8D70\u5230\u533B\u751F\u4F11\u606F\u7684\u5730\u65B9\uFF0C\u53EA\u89C1\u4ED6\u6B63\u7761\u5F97\u9999\u751C\uFF0C\u5747\u5300\u7684\u547C\u5438\u58F0\u5728\u5BC2\u9759\u7684\u75C5\u623F\u91CC\u683C\u5916\u6E05\u6670\u3002\u4ED6\u7684\u8138\u4E0A\u5E26\u7740\u4E00\u79CD\u653E\u677E\u7684\u795E\u60C5\uFF0C\u4F3C\u4E4E\u5728\u8FD9\u7247\u523B\u7684\u7761\u7720\u4E2D\uFF0C\u5FD8\u5374\u4E86\u6240\u6709\u7684\u70E6\u607C\u3002"
  - "\u770B\u7740\u4ED6\u7761\u5F97\u8FD9\u4E48\u9999\uFF0C\u6211\u5FC3\u91CC\u6709\u4E9B\u72B9\u8C6B\u4E86\u3002\u6BD5\u7ADF\u4ED6\u5E73\u65F6\u4E5F\u5F88\u8F9B\u82E6\uFF0C\u6BCF\u5929\u90FD\u8981\u7167\u987E\u6211\u4EEC\u8FD9\u4E9B\u75C5\u4EBA\u3002\u6211\u5B9E\u5728\u4E0D\u5FCD\u5FC3\u6253\u6270\u4ED6\u8FD9\u96BE\u5F97\u7684\u4F11\u606F\u65F6\u5149\uFF0C\u8FD8\u662F\u7B97\u4E86\u5427\u3002"
  - "\u65E2\u7136\u4E0D\u80FD\u6253\u6270\u533B\u751F\uFF0C\u90A3\u770B\u770B\u7535\u89C6\u5427\u3002\u8BF4\u4E0D\u5B9A\u7535\u89C6\u91CC\u4F1A\u6709\u4E00\u4E9B\u6709\u8DA3\u7684\u65B0\u95FB\uFF0C\u6216\u8005\u662F\u7CBE\u5F69\u7684\u8282\u76EE\uFF0C\u80FD\u8BA9\u6211\u6682\u65F6\u5FD8\u6389\u8FD9\u65E0\u804A\u7684\u751F\u6D3B\u3002\u4E07\u4E00\u6709\u4EC0\u4E48\u65B0\u9C9C\u4E8B\u5462\uFF0C\u6211\u6EE1\u6000\u671F\u5F85\u5730\u60F3\u7740\u3002"
  - "\u55EF\uFF0C\u5F97\u53BB\u627E\u627E\u7535\u89C6\u9065\u63A7\u5668\uFF0C\u8FD9\u73A9\u610F\u9694\u4E09\u5DEE\u4E94\u5C31\u627E\u4E0D\u7740\uFF0C\u597D\u50CF\u662F\u4E4B\u524D\u5230\u5E8A\u5E95\u4E0B\u53BB\u4E86\uFF1F"
