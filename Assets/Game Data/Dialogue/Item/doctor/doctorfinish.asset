  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: doctorfinish
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u201C\u533B\u751F\uFF0C\u8FD9\u4E2A\u884C\u5417\uFF1F\u201D\u6211\u88C5\u51FA\u4E00\u526F\u82E5\u65E0\u5176\u4E8B\u7684\u6837\u5B50\uFF0C\u628A\u6CE1\u9762\u9012\u4E86\u8FC7\u53BB\u3002"
  - "\u4ED6\u63A5\u8FC7\u6CE1\u9762\uFF0C\u76B1\u7740\u7709\u5934\u7785\u4E86\u4E00\u773C\uFF0C\u82E6\u7B11\u7740\u8BF4\uFF1A\u201C\u6CE1\u9762\uFF1F\u7B97\u4E86\uFF0C\u603B\u6BD4\u997F\u6B7B\u5F3A\u3002\u201D
    \u4ED6\u62D6\u7740\u75B2\u60EB\u7684\u6B65\u5B50\u8D70\u5411\u89D2\u843D\u7684\u5C0F\u684C\uFF0C\u5634\u91CC\u8FD8\u561F\u56D4\u7740\uFF0C\u201C\u5E0C\u671B\u6CA1\u8FC7\u671F\u2026\u2026
    \u6709\u70ED\u6C34\u5417\uFF1F\u201D"
  - "- \u201C\u5443\u2026\u2026\u6CA1\u6709\u3002\u201D\u6211\u6320\u5934\uFF0C\u201C\u8981\u4E0D\u6211\u5E2E\u60A8\u627E\u627E\uFF1F\u201D"
  - "\u4ED6\u6446\u4E86\u6446\u624B\uFF0C\u8BED\u6C14\u4E2D\u5E26\u7740\u4E9B\u8BB8\u4E0D\u8010\u70E6\uFF1A\u201C\u522B\u9EBB\u70E6\u4E86\uFF0C\u6211\u81EA\u5DF1\u6765\u3002\u201D
    \u4ED6\u4F4E\u4E0B\u5934\uFF0C\u4E13\u5FC3\u6446\u5F04\u8D77\u6CE1\u9762\uFF0C\u4F3C\u4E4E\u5B8C\u5168\u628A\u6211\u7ED9\u5FD8\u4E86\u3002"
  - "\u8D81\u7740\u8FD9\u4E2A\u673A\u4F1A\uFF0C\u6211\u77A5\u4E86\u4E00\u773C\u4ED6\u521A\u624D\u5750\u8FC7\u7684\u5730\u65B9\uFF0C\u6795\u5934\u4E0A\u6709\u4E2A\u4E1C\u897F\u95EA\u4E86\u4E00\u4E0B\u5149
    \u2014\u2014 \u662F\u4E00\u5757\u7EB8\u7247\uFF0C\u50CF\u662F\u75C5\u4F8B\u62A5\u544A\u7684\u788E\u7247\u3002\u6211\u7684\u5FC3\u8DF3\u9661\u7136\u52A0\u5FEB\uFF0C\u5047\u88C5\u6574\u7406\u5E8A\u94FA\uFF0C\u6084\u6084\u5730\u628A\u5B83\u585E\u8FDB\u53E3\u888B\u3002\u4E0A\u9762\u5199\u7740\uFF1A\u201C\u5B9E\u9A8C\u7F16\u53F7\u2026\u2026
    \u8BB0\u5FC6\u6291\u5236\u2026\u2026\u201D \u8FD9\u548C\u6211\u7684\u68A6\u4F1A\u6709\u5173\u7CFB\u5417\uFF1F"
