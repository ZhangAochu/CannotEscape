  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: docotrhas
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u6211\u5411\u533B\u751F\u5BF9\u7535\u89C6\u58F0\u97F3\u592A\u5927\u800C\u62B1\u6B49\u3002"
  - "\u533B\u751F\u63C9\u7740\u592A\u9633\u7A74\uFF0C\u773C\u795E\u4E2D\u900F\u7740\u4E00\u4E1D\u8FF7\u832B\uFF0C\u53F9\u4E86\u53E3\u6C14\u8BF4\u9053\uFF1A\u201C\u65B0\u95FB\uFF1F\u8FD9\u513F\u53EA\u6709\u4E9B\u65E7\u5F55\u50CF\u3002\u201D
    \u4ED6\u987F\u4E86\u987F\uFF0C\u53C8\u538B\u4F4E\u58F0\u97F3\u8BF4\uFF0C\u201C\u522B\u770B\u592A\u591A\uFF0C\u7701\u5F97\u5934\u75BC\u3002\u201D"
  - "\u6211\u6123\u4E86\u4E00\u4E0B\uFF0C\u4ED6\u8FD9\u8BDD\u662F\u4EC0\u4E48\u610F\u601D\uFF1F\u50CF\u662F\u5173\u5FC3\uFF0C\u53C8\u50CF\u662F\u2026\u2026\u8B66\u544A\uFF1F\u6211\u4F4E\u5934\u63A9\u9970\u81EA\u5DF1\u7684\u4E0D\u5B89\uFF0C\u5600\u5495\u9053\uFF1A\u201C\u597D\u5427\uFF0C\u6211\u77E5\u9053\u4E86\u3002\u201D"
  - "\u4ED6\u6CA1\u518D\u542D\u58F0\uFF0C\u53EA\u662F\u76B1\u7740\u7709\u5934\uFF0C\u63C9\u4E86\u63C9\u5495\u5495\u53EB\u7684\u809A\u5B50\uFF0C\u81EA\u8A00\u81EA\u8BED\u9053\uFF1A\u201C\u5567\uFF0C\u997F\u5F97\u4E0D\u884C\u4E86\u2026\u2026
    \u8FD9\u7834\u5730\u65B9\uFF0C\u8FDE\u70B9\u5403\u7684\u90FD\u6CA1\u6709\u3002\u201D"
  - "\u6211\u6123\u4E86\u4E00\u4E0B\uFF0C\u73AF\u987E\u623F\u95F4\u3002\u5403\u7684\uFF1F\u8FD9\u5730\u65B9\u8FDE\u7A7A\u6C14\u90FD\u900F\u7740\u6D88\u6BD2\u6C34\u7684\u5473\u9053\uFF0C\u54EA\u6765\u7684\u98DF\u7269\uFF1F\u4E0D\u8FC7\uFF0C\u6211\u7A81\u7136\u60F3\u8D77\u5783\u573E\u6876\u2014\u2014\u4E0A\u6B21\u6E05\u7406\u7684\u65F6\u5019\uFF0C\u597D\u50CF\u770B\u5230\u8FC7\u4EC0\u4E48\u4E1C\u897F\u3002"
