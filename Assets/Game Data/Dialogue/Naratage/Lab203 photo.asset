  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: Lab203 photo
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u67DC\u5B50\u91CC\u653E\u7740\u4E00\u672C\u7834\u65E7\u7684\u65E5\u8BB0\u672C\u548C\u4E00\u5F20\u6CDB\u9EC4\u7684\u7167\u7247\u3002"
  - "\u5FC3\u77AC\u95F4\u63D0\u5230\u4E86\u55D3\u5B50\u773C \u2014\u2014 \u7167\u7247\u4E0A\u662F\u4E00\u4E2A\u5C0F\u5973\u5B69\u548C\u4E00\u4E2A\u7A7F\u7740\u767D\u5927\u8902\u7684\u7537\u4EBA\uFF0C\u4ED6\u4EEC\u9762\u5E26\u5FAE\u7B11\uFF0C\u7AD9\u5728\u9633\u5149\u4E0B\uFF0C\u5C0F\u5973\u5B69\u6B63\u662F\u5E74\u5E7C\u7684\u6211\uFF01"
  - "\u53EF\u7537\u4EBA\u7684\u90A3\u90E8\u5206\u7167\u7247\u5374\u88AB\u4EBA\u7C97\u66B4\u5730\u6495\u88C2\u4E86\uFF0C\u53EA\u7559\u4E0B\u4E00\u4E9B\u6A21\u7CCA\u7684\u8863\u89D2\u548C\u65AD\u88C2\u7684\u98CE\u7B5D\u56FE\u6848\u3002"
  - "\u6211\u7FFB\u6765\u8986\u53BB\u5730\u770B\u7740\u7167\u7247\uFF0C\u8BD5\u56FE\u4ECE\u6B8B\u5B58\u7684\u90E8\u5206\u4E2D\u8FA8\u8BA4\u51FA\u7537\u4EBA\u7684\u6A21\u6837\uFF0C\u7A81\u7136\u53D1\u73B0\u7167\u7247\u80CC\u9762\u5199\u7740\u4E00\u884C\u5C0F\u5B57\uFF1A\u201C\u522B\u76F8\u4FE1\u4ED6\u4EEC\uFF0C\u4F60\u7684\u8BB0\u5FC6\u88AB\u7BE1\u6539\u4E86
    \u2014\u2014 \u6797\u533B\u751F\u201D\u3002"
  - "\u6797\u533B\u751F\uFF1F\u96BE\u9053\u5C31\u662F\u4E00\u76F4\u7167\u987E\u6211\u7684\u90A3\u4E2A\u533B\u751F\uFF1F\u8FD9\u5F20\u7167\u7247\u662F\u771F\u5B9E\u5B58\u5728\u7684\u5417\uFF1F\u8FD8\u662F\u8BF4\uFF0C\u8FD9\u4E5F\u662F
    \u201C\u533B\u9662\u201D \u8BBE\u4E0B\u7684\u53E6\u4E00\u4E2A\u9677\u9631\uFF1F"
  - "\u6216\u8BB8\u8FD9\u4E00\u5207\uFF0C\u90FD\u9700\u8981\u6253\u5F00203\u6700\u540E\u7684\u95E8\u624D\u77E5\u9053\u4E86"
