  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: DreamNaratage
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u523A\u773C\u7684\u9633\u5149\u503E\u6CFB\u800C\u4E0B\uFF0C\u4E00\u4E2A\u7A7F\u7740\u6E05\u51C9\u77ED\u8896\u7684\u7537\u4EBA\u8E72\u5728\u6211\u9762\u524D\uFF0C\u4ED6\u7684\u5F71\u5B50\u5728\u5E72\u88C2\u7684\u5730\u9762\u4E0A\u62C9\u5F97\u5F88\u957F\u3002"
  - " \u4ED6\u8F7B\u8F7B\u5730\u7275\u8D77\u6211\u7684\u624B\uFF0C\u638C\u5FC3\u7684\u6E29\u6696\u7A7F\u900F\u76AE\u80A4\uFF0C\u5E26\u6765\u4E00\u9635\u4EFF\u82E5\u865A\u5E7B\u7684\u5B89\u5FC3\u4E4B\u611F\u3002"
  - "\u4ED6\u5C06\u6211\u9AD8\u9AD8\u4E3E\u8D77\uFF0C\u8D8A\u8FC7\u4ED6\u7684\u5934\u9876\uFF0C\u5E26\u7740\u6211\u8D70\u5230\u9662\u5899\u8FB9\u3002\u90A3\u4E00\u523B\uFF0C\u6211\u7EC8\u4E8E\u5F97\u4EE5\u7AA5\u89C1\u5916\u9762\u7684\u4E16\u754C\u3002"
  - "\u8FDC\u5904\u7684\u5927\u697C\u597D\u4F3C\u5BC6\u5BC6\u9EBB\u9EBB\u6324\u5728\u4E00\u8D77\u7684\u6613\u62C9\u7F50\uFF0C\u5F7C\u6B64\u95F4\u6BEB\u65E0\u7F1D\u9699\uFF0C\u538B\u6291\u5F97\u8BA9\u4EBA\u5598\u4E0D\u8FC7\u6C14\u3002"
  - "\u6211\u7AED\u529B\u60F3\u8981\u770B\u6E05\u4ED6\u7684\u9762\u5BB9\uFF0C\u53EF\u65E0\u8BBA\u5982\u4F55\u90FD\u65E0\u6CD5\u770B\u6E05\uFF0C\u53EA\u4F9D\u7A00\u8BB0\u5F97\u4ED6\u77ED\u8896\u4E0A\u7684\u56FE\u6848----\u4E00\u53EA\u6A21\u7CCA\u4E0D\u6E05\u7684\u65AD\u7EBF\u98CE\u7B5D\uFF0C\u5B64\u96F6\u96F6\u5730\u5370\u5728\u5E03\u6599\u4E4B\u4E0A\u3002"
