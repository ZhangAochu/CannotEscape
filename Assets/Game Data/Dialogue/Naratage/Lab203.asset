  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: Lab203
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u63A8\u5F00\u95E8\u7684\u77AC\u95F4\uFF0C\u4E00\u80A1\u5E26\u7740\u5BD2\u610F\u7684\u96FE\u6C14\u6251\u9762\u800C\u6765\uFF0C\u51E0\u4E4E\u8BA9\u6211\u7741\u4E0D\u5F00\u773C\u3002"
  - "\u7B49\u96FE\u6C14\u7A0D\u7A0D\u6563\u53BB\uFF0C\u773C\u524D\u7684\u666F\u8C61\u8BA9\u6211\u5012\u5438\u4E00\u53E3\u51B7\u6C14
    \u2014\u2014 \u623F\u95F4\u4E2D\u592E\u6574\u6574\u9F50\u9F50\u6392\u5217\u7740\u5341\u51E0\u4E2A\u5DE8\u5927\u7684\u5706\u67F1\u5F62\u57F9\u517B\u76BF\uFF0C\u5E7D\u84DD\u7684\u6DB2\u4F53\u5728\u5176\u4E2D\u7F13\u7F13\u6D41\u52A8\uFF0C\u91CC\u9762\u6F02\u6D6E\u7740\u4E00\u4E2A\u4E2A\u6A21\u7CCA\u7684\u8EAB\u5F71\u3002"
  - "\u6BCF\u4E00\u4E2A\u8EAB\u5F71\u90FD\u50CF\u662F\u8737\u7F29\u5728\u8327\u4E2D\u7684\u86F9\uFF0C\u4ED6\u4EEC\u7684\u8EAB\u4F53\u88AB\u65E0\u6570\u900F\u660E\u7684\u7BA1\u7EBF\u7F20\u7ED5\u7740\uFF0C\u90A3\u4E9B\u7BA1\u7EBF\u5EF6\u4F38\u5230\u57F9\u517B\u76BF\u5916\uFF0C\u8FDE\u63A5\u7740\u5899\u4E0A\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u4EEA\u5668\uFF0C\u53D1\u51FA\u89C4\u5F8B\u7684
    \u201C\u6EF4\u7B54\u201D \u58F0\uFF0C\u50CF\u662F\u67D0\u79CD\u8BE1\u5F02\u7684\u5FC3\u8DF3\u3002"
  - "\u6211\u7684\u76EE\u5149\u88AB\u6700\u89D2\u843D\u7684\u4E00\u4E2A\u57F9\u517B\u76BF\u7262\u7262\u5438\u5F15\uFF0C\u90A3\u91CC\u9762\u7684\u8EAB\u5F71\u2026\u2026
    \u5206\u660E\u7A7F\u7740\u548C\u6211\u4E00\u6A21\u4E00\u6837\u7684\u8863\u670D\uFF01"
  - "\u6E7F\u6F09\u6F09\u7684\u5934\u53D1\u8D34\u5728\u8138\u4E0A\uFF0C\u9690\u7EA6\u9732\u51FA\u7684\u9762\u5BB9\u7ADF\u548C\u6211\u5982\u51FA\u4E00\u8F99\u3002"
  - "\u6211\u98A4\u6296\u7740\u8D70\u8FD1\uFF0C\u624B\u6307\u629A\u4E0A\u51B0\u51B7\u7684\u73BB\u7483\uFF0C\u57F9\u517B\u76BF\u4E2D\u7684
    \u201C\u6211\u201D \u7A81\u7136\u7741\u5F00\u4E86\u773C\u775B\uFF01"
  - "\u90A3\u53CC\u773C\u775B\u7A7A\u6D1E\u65E0\u795E\uFF0C\u5374\u53C8\u4EFF\u4F5B\u85CF\u7740\u65E0\u5C3D\u7684\u75DB\u82E6\u4E0E\u7EDD\u671B\uFF0C\u76F4\u52FE\u52FE\u5730\u76EF\u7740\u6211\uFF0C\u5634\u89D2\u5FAE\u5FAE\u4E0A\u626C\uFF0C\u626F\u51FA\u4E00\u4E2A\u8BE1\u5F02\u7684\u5F27\u5EA6\u3002"
  - "\u6211\u5413\u5F97\u8E09\u8DC4\u540E\u9000\uFF0C\u540E\u80CC\u649E\u4E0A\u65C1\u8FB9\u7684\u4EEA\u5668\uFF0C\u53D1\u51FA\u4E00\u9635\u523A\u8033\u7684\u58F0\u54CD\u3002"
  - "\u201C\u8FD9\u2026\u2026 \u8FD9\u5230\u5E95\u662F\u600E\u4E48\u56DE\u4E8B\uFF1F\u201D
    \u6211\u5583\u5583\u81EA\u8BED\uFF0C\u58F0\u97F3\u5728\u7A7A\u8361\u8361\u7684\u623F\u95F4\u91CC\u56DE\u8361\u3002\u96BE\u9053\u8FD9\u4E9B\u90FD\u662F\u548C\u6211\u4E00\u6837\u7684\u5B9E\u9A8C\u4F53\uFF1F\u800C\u90A3\u4E2A
    \u201C\u6211\u201D\uFF0C\u662F\u8FC7\u53BB\u7684\u6211\u5417\uFF1F\u90A3\u88AB\u675F\u7F1A\u5728\u57F9\u517B\u76BF\u4E2D\u7684\u8EAF\u4F53\uFF0C\u662F\u4E0D\u662F\u6211\u5931\u53BB\u7684\u771F\u5B9E\u8EAB\u4F53\uFF1F"
  - "\u4ECE\u770B\u5230\u57F9\u517B\u76BF\u7684\u9707\u60CA\u4E2D\u7F13\u8FC7\u795E\u6765\uFF0C\u6211\u6DF1\u77E5\u8FD9\u91CC\u85CF\u7740\u592A\u591A\u79D8\u5BC6\u3002\u53EF\u773C\u4E0B\u5B64\u7ACB\u65E0\u63F4\uFF0C\u5F97\u627E\u4E9B\u6709\u7528\u7EBF\u7D22\u3002\u73AF\u987E\u56DB\u5468\uFF0C\u90A3\u5E03\u6EE1\u7070\u5C18\u7684\u6728\u8D28\u4FDD\u9669\u67DC\u6620\u5165\u773C\u5E18\uFF0C\u6216\u8BB8\u85CF\u7740\u7B54\u6848\u3002"
