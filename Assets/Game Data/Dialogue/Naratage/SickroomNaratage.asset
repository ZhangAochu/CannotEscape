  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: SickroomNaratage
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u201C\u662F\u8C01\u2026\u2026\u5728\u8BF4\u8BDD\uFF1F\u201D\u6211\u8FF7\u8FF7\u7CCA\u7CCA\u5730\u7741\u5F00\u773C\uFF0C\u5934\u75DB\u6B32\u88C2\u3002"
  - "\u6211\u2026\u2026\u6211\u8FD9\u662F\u5728\u54EA\u513F\uFF1F"
  - "\u521A\u521A\u90A3\u4E2A\u68A6\u2026\u2026\u9633\u5149\u90A3\u4E48\u523A\u773C\uFF0C\u8FD8\u6709\u90A3\u4E2A\u7537\u4EBA\u2026\u2026\u4ED6\u7A76\u7ADF\u662F\u8C01\uFF1F"
  - "\u5934\u597D\u75BC\uFF01\u90A3\u662F\u6211\u7684\u8BB0\u5FC6\u5417\uFF1F\u8FD8\u662F\u53EA\u662F\u5E7B\u89C9\uFF1F"
  - "(\u6DF1\u5438\u4E00\u53E3\u6C14\uFF09\u53C8\u662F\u8FD9\u7834\u65E7\u7684\u9876\u706F\uFF0C\u53D1\u9EC4\u7684\u706F\u7F69\u6563\u53D1\u7740\u660F\u6697\u7684\u5149\uFF0C\u5C31\u50CF\u4E00\u4E2A\u6C14\u606F\u5944\u5944\u7684\u592A\u9633\u3002\u8FD9\u91CC\u662F\u6211\u7684\u623F\u95F4\u2026\u2026
    \u4EA6\u6216\u662F\u7262\u623F\uFF1F\u523A\u9F3B\u7684\u6D88\u6BD2\u6C34\u5473\u5F25\u6F2B\u5728\u7A7A\u6C14\u4E2D\uFF0C\u600E\u4E48\u4E5F\u6325\u6563\u4E0D\u53BB\u3002"
  - "\u6BCF\u65E5\u7686\u662F\u5982\u6B64\uFF0C\u9192\u6765\u9762\u5BF9\u7684\u4FBF\u662F\u8FD9\u822C\u666F\u8C61\u3002\u8FC7\u4E86\u51E0\u5929\uFF1F\u51E0\u4E2A\u6708\uFF1F\u2026\u2026
    \u8C01\u53C8\u77E5\u6653\u5462\u3002\u53CD\u6B63\u6211\u4EC0\u4E48\u90FD\u8BB0\u4E0D\u6E05\u695A\u4E86\u3002"
  - "\u90A3\u8FB9\u662F\u6211\u7684\u4E3B\u6CBB\u533B\u751F... \u4ED6\u603B\u662F\u8EBA\u5728\u90A3\u91CC\uFF0C\u4E00\u52A8\u4E0D\u52A8\uFF0C\u5B9B\u5982\u4E00\u5EA7\u96D5\u5851\u3002"
  - "\u8FD9\u91CC\u662F\u7CBE\u795E\u75C5\u9662... \u4ED6\u4EEC\u90FD\u8FD9\u4E48\u8BF4\u3002
    \u771F\u7684\u662F\u8FD9\u6837\u5417\uFF1F \u6211\u4E5F\u4E0D\u77E5\u9053...
    \u53CD\u6B63\u6211\u4EC0\u4E48\u90FD\u8BB0\u4E0D\u8D77\u6765\u4E86\u3002"
  - "\u533B\u751F\u4EBA\u8FD8\u4E0D\u9519\uFF0C\u6001\u5EA6\u633A\u6E29\u548C\u7684\u3002
    \u4E5F\u8BB8\u5427... \u4E5F\u8BB8\u4ED6\u53EA\u662F\u5728\u6577\u884D\u6211\u7F62\u4E86\u3002"
  - "\u6211\u7684\u8111\u5B50\u50CF\u88AB\u6E05\u7A7A\u4E86\u4E00\u822C\uFF0C\u8FC7\u53BB\u7684\u4E8B\u60C5\u5982\u540C\u88AB\u6A61\u76AE\u64E6\u62B9\u53BB\uFF0C\u53EA\u5269\u4E0B\u65AD\u65AD\u7EED\u7EED\u7684\u788E\u7247"
  - "\u4E5F\u8BB8\u6211\u771F\u7684\u75C5\u4E86\u5427\u2026\u2026\u5C31\u5F53\u8FD9\u91CC\u662F\u7CBE\u795E\u75C5\u9662\uFF0C\u63A5\u53D7\u73B0\u5B9E\u4F3C\u4E4E\u4E5F\u5E76\u975E\u96BE\u4EE5\u5FCD\u53D7\u3002"
  - "\u597D\u65E0\u804A\uFF0C\u6BCF\u5929\u5343\u7BC7\u4E00\u5F8B\uFF0C\u771F\u60F3\u51FA\u53BB\u900F\u900F\u6C14\u3002"
  - "\u6216\u8BB8\u533B\u751F\u90A3\u91CC\u4F1A\u6709\u4E00\u4E9B\u4E0D\u4E00\u6837\u7684\u6D88\u606F\u5427\uFF0C\u8BF4\u4E0D\u5B9A\u4ED6\u80FD\u7ED9\u6211\u5E26\u6765\u4E00\u4E9B\u65B0\u9C9C\u4E8B\u513F\u3002\u6211\u5FC3\u91CC\u8FD9\u6837\u60F3\u7740\uFF0C\u51B3\u5B9A\u53BB\u95EE\u95EE\u4ED6\u3002"
