  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: TV
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u7EC8\u4E8E\u7406\u597D\u7EBF\uFF0C\u6211\u6309\u4E0B\u7535\u6E90\u952E\uFF0C\u5C4F\u5E55\u95EA\u70C1\uFF0C\u4F4E\u9E23\u4E00\u58F0\uFF0C\u7F13\u7F13\u4EAE\u8D77\u3002"
  - "\u7535\u89C6\u91CC\u64AD\u653E\u7740\u4E00\u5219\u65E7\u65B0\u95FB\uFF0C\u753B\u9762\u5448\u73B0\u51FA\u51E0\u5E74\u524D\u7684\u8857\u9053\u666F\u8C61\uFF1A\u7A7A\u8361\u8361\u7684\u9A6C\u8DEF\uFF0C\u6234\u7740\u53E3\u7F69\u884C\u8272\u5306\u5306\u7684\u4EBA\u7FA4\uFF0C\u533B\u9662\u91CC\u5FD9\u788C\u4E0D\u505C\u7684\u8EAB\u5F71\u3002\u64AD\u97F3\u5458\u7528\u4F4E\u6C89\u7684\u58F0\u97F3\u8BB2\u8FF0\u7740\u90A3\u573A\u75AB\u60C5\u5982\u4F55\u5982\u6F6E\u6C34\u822C\u5E2D\u5377\u800C\u6765\uFF0C\u6539\u53D8\u4E86\u65E0\u6570\u4EBA\u7684\u751F\u6D3B\u3002\u6211\u7D27\u76EF\u7740\u5C4F\u5E55\uFF0C\u5FC3\u5E95\u6D8C\u8D77\u4E00\u80A1\u5F3A\u70C8\u7684\u538B\u6291\u611F\uFF0C\u4EFF\u4F5B\u6709\u4EC0\u4E48\u4E1C\u897F\u88AB\u6084\u7136\u89E6\u52A8\u3002"
  - "\u753B\u9762\u5207\u5230\u4E00\u95F4\u75C5\u623F\uFF0C\u955C\u5934\u7F13\u7F13\u626B\u8FC7\u75C5\u5E8A\uFF0C\u6211\u7684\u5FC3\u8DF3\u9661\u7136\u52A0\u5FEB\u2014\u2014\u90A3\u4E2A\u4EBA\u5F71\u2026\u2026\u4E3A\u4EC0\u4E48\u90A3\u4E48\u719F\u6089\uFF1F"
  - "\u7A81\u7136\uFF0C\u6211\u7684\u89C6\u7EBF\u53D8\u5F97\u6A21\u7CCA\u8D77\u6765\uFF0C\u5899\u4E0A\u6D6E\u73B0\u51FA\u4E00\u4E32\u6570\u5B57
    \u2014\u20148203\u3002\u5B83\u4EEC\u626D\u66F2\u53D8\u5F62\uFF0C\u5982\u540C\u574F\u6389\u7684\u663E\u793A\u5C4F\uFF0C\u6570\u5B57
    8 \u7684\u7EBF\u6761\u5B8C\u5168\u6697\u4E86\u4E0B\u53BB\uFF0C\u597D\u4F3C\u88AB\u4EBA\u523B\u610F\u62B9\u53BB\u4E00\u822C\u3002\u6211\u63C9\u4E86\u63C9\u773C\u775B\uFF0C\u6570\u5B57\u77AC\u95F4\u6D88\u5931\u4E0D\u89C1\uFF0C\u53EA\u5269\u4E0B\u7A7A\u8361\u8361\u7684\u767D\u8272\u5899\u58C1\u3002\u8FD9\u662F\u5E7B\u89C9\u5417\uFF1F\u8FD8\u662F\u2026\u2026"
  - "\u7535\u89C6\u7EE7\u7EED\uFF0C\u64AD\u97F3\u5458\u63D0\u5230\u201C\u5B9E\u9A8C\u6027\u6CBB\u7597\u201D\uFF0C\u8A00\u8BED\u95F4\u542B\u7CCA\u5176\u8F9E\uFF0C\u53EA\u8BF4\u201C\u90E8\u5206\u60A3\u8005\u51FA\u73B0\u4E0D\u53EF\u9006\u526F\u4F5C\u7528\u201D\u3002\u5934\u75DB\u518D\u6B21\u88AD\u6765\uFF0C\u5C31\u50CF\u6709\u4EBA\u5728\u6211\u7684\u8111\u888B\u91CC\u62FC\u547D\u6572\u9F13\u3002"
  - "\u4E00\u9635\u523A\u8033\u7684\u80CC\u666F\u97F3\u4E50\u6253\u7834\u4E86\u5BC2\u9759\uFF0C\u6211\u4E0B\u610F\u8BC6\u5730\u77A5\u5411\u89D2\u843D\uFF0C\u533B\u751F\u88AB\u8FD9\u58F0\u97F3\u5435\u9192\uFF0C\u76B1\u7740\u7709\u5934\u5750\u8D77\u8EAB\u6765\uFF0C\u63C9\u7740\u60FA\u5FEA\u7684\u7761\u773C\u3002"
  - "\u201C\u5582\uFF0C\u58F0\u97F3\u80FD\u4E0D\u80FD\u8C03\u5C0F\u70B9\uFF1F\u201D
    \u4ED6\u4F4E\u58F0\u62B1\u6028\u7740\uFF0C\u8BDD\u8BED\u4E2D\u5E26\u7740\u51E0\u5206\u6DF1\u6DF1\u7684\u5026\u610F\uFF0C\u4EFF\u4F5B\u521A\u4ECE\u4E00\u573A\u53EF\u6015\u7684\u5669\u68A6\u4E2D\u6323\u8131\u51FA\u6765\u3002"
  - "\u201C\u62B1\u6B49\uFF0C\u533B\u751F\uFF0C\u6211\u6CA1\u6CE8\u610F\u2026\u2026\u201D\u6211\u8D76\u7D27\u6309\u4E0B\u9065\u63A7\u5668\uFF0C\u628A\u97F3\u91CF\u8C03\u4F4E\uFF0C\u5FC3\u8DF3\u5374\u6709\u70B9\u52A0\u5FEB\uFF0C\u201C\u5C31\u60F3\u770B\u770B\u5916\u9762\u6709\u4EC0\u4E48\u65B0\u95FB\u3002\u201D"
  - "\u6211\u8D76\u5FD9\u5411\u533B\u751F\u8D70\u53BB\u3002"
