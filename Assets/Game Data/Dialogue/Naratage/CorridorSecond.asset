--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: CorridorSecond
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u6211\u7D27\u5F20\u5F97\u5C4F\u4F4F\u4E86\u547C\u5438\uFF0C\u624B\u4E5F\u6296\u4E2A\u4E0D\u505C\u3002\u7B2C\u4E00\u5200\u6254\u504F\u4E86\uFF0C\u64E6\u7740\u5979\u7684\u80A9\u8180\u98DE\u4E86\u8FC7\u53BB\uFF0C\u5979\u53D1\u51FA\u4E00\u9635\u5C16\u9510\u523A\u8033\u7684\u7B11\u58F0\uFF0C\u90A3\u58F0\u97F3\u5C31\u50CF\u4E00\u6839\u5C16\u9510\u7684\u9488\u76F4\u76F4\u523A\u8FDB\u6211\u7684\u8111\u5B50\u91CC\u3002"
  - "\u7B2C\u4E8C\u5200\u51FB\u4E2D\u4E86\u5979\u7684\u624B\u81C2\uFF0C\u5979\u8EAB\u5B50\u6643\u4E86\u6643\uFF0C\u6CE8\u5C04\u5668\u4E5F\u8DDF\u7740\u6643\u52A8\u8D77\u6765\u3002"
  - "\u7B2C\u4E09\u5200\uFF0C\u6211\u54AC\u7740\u7259\u7528\u529B\u6254\u51FA\uFF0C\u6B63\u4E2D\u5979\u7684\u80F8\u53E3\u3002\u5979\u53D1\u51FA\u4E00\u58F0\u602A\u5F02\u7684\u53EB\u58F0\uFF0C\u8EAB\u5B50\u4E00\u6B6A\uFF0C\u8DCC\u8FDB\u4E86\u65E0\u5C3D\u9ED1\u6697\u4E4B\u4E2D\uFF0C\u6CE8\u5C04\u5668\u6389\u843D\u5728\u5730\u4E0A\uFF0C\u53D1\u51FA\u6E05\u8106\u7684
    \u201C\u53EE\u5F53\u201D \u58F0\uFF0C\u5982\u540C\u65AD\u4E86\u7684\u98CE\u7B5D\u7EBF\u3002"
  - "\u6211\u5598\u7740\u7C97\u6C14\uFF0C\u7D27\u7D27\u76EF\u7740\u5979\u5148\u524D\u5728\u7684\u5730\u65B9\u3002\u9ED1\u6697\u4E2D\u4EC0\u4E48\u90FD\u6CA1\u6709\uFF0C\u4EFF\u4F5B\u5979\u4ECE\u672A\u51FA\u73B0\u8FC7\u4E00\u6837\u3002"
  - "\u53EF\u6211\u7684\u624B\u8FD8\u5728\u4E0D\u505C\u5730\u98A4\u6296\uFF0C\u8111\u6D77\u4E2D\u4E0D\u7531\u81EA\u4E3B\u5730\u95EA\u8FC7\u68A6\u5883\u4E2D\u7684\u7247\u6BB5
    \u2014\u2014 \u523A\u773C\u7684\u9633\u5149\u3001\u98CE\u7B5D\u3001\u7537\u4EBA\u7684\u624B\u2026\u2026
    \u6211\u7528\u529B\u7529\u4E86\u7529\u5934\uFF0C\u722C\u51FA\u7A97\u6237\uFF0C\u53CC\u811A\u8E29\u5728\u4E86\u5ECA\u9053\u51B0\u51B7\u7684\u5730\u9762\u4E0A\u3002"
  - "\u6211\u7684\u8111\u6D77\u91CC\uFF0C\u68A6\u5883\u7684\u788E\u7247\u4E0D\u65AD\u5730\u53CD\u590D\u6D6E\u73B0\uFF1A\u8000\u773C\u7684\u9633\u5149\u3001\u7A7F\u7740\u77ED\u8896\u7684\u7537\u4EBA\u90A3\u6A21\u7CCA\u4E0D\u6E05\u7684\u8EAB\u5F71\u3001\u98CE\u7B5D\u5728\u5929\u7A7A\u4E2D\u7A81\u7136\u65AD\u7EBF\u5760\u843D\u2026\u2026
    \u8FD8\u6709\u90A3\u4E32\u6570\u5B57\uFF0C8203\uFF0C\u5C31\u50CF\u6DF1\u6DF1\u5730\u70D9\u5370\u5728\u4E86\u6211\u7684\u8111\u6D77\u91CC\u3002"
  - "\u6211\u4E0D\u77E5\u9053\u5B83\u5230\u5E95\u4EE3\u8868\u7740\u4EC0\u4E48\uFF0C\u5374\u53C8\u611F\u89C9\u5B83\u50CF\u662F\u4E00\u53EA\u65E0\u5F62\u7684\u624B\uFF0C\u5728\u7275\u5F15\u7740\u6211\u4E0D\u65AD\u5411\u524D\u3002\u5ECA\u9053\u4E24\u4FA7\u7684\u95E8\u90FD\u7D27\u7D27\u9501\u7740\uFF0C\u95E8\u724C\u4E0A\u7684\u6570\u5B57\u5DF2\u7ECF\u88AB\u522E\u82B1\u5F97\u770B\u4E0D\u6E05\u4E86\uFF0C\u552F\u6709\u90A3\u4E9B\u98CE\u7B5D\u5F62\u72B6\u7684\u5212\u75D5\u6E05\u6670\u53EF\u89C1\uFF0C\u4EFF\u4F5B\u5728\u4E3A\u6211\u6307\u5F15\u7740\u524D\u884C\u7684\u65B9\u5411\u3002"
  - "\u9053\u7684\u5C3D\u5934\u662F\u4E00\u6247\u94C1\u95E8\uFF0C\u95E8\u4E0A\u523B\u7740\u4E00\u53EA\u65AD\u7EBF\u7684\u98CE\u7B5D\uFF0C\u7EBF\u6761\u523B\u5F97\u5341\u5206\u7C97\u7CD9\uFF0C\u5C31\u50CF\u662F\u5B69\u5B50\u7528\u5200\u968F\u610F\u5212\u51FA\u6765\u7684\u3002"
  - "\u6211\u7684\u5FC3\u8DF3\u9661\u7136\u52A0\u5FEB\uFF0C\u8FD9\u4E2A\u7B26\u53F7\u2026\u2026
    \u8DDF\u6211\u68A6\u91CC\u89C1\u5230\u7684\u4E00\u6A21\u4E00\u6837\uFF01\u95E8\u65C1\u8FB9\u6709\u4E2A\u5BC6\u7801\u9501\uFF0C\u9700\u8981\u8F93\u5165\u56DB\u4E2A\u6570\u5B57\u3002"
  - "\u6211\u54BD\u4E86\u53E3\u553E\u6CAB\uFF0C\u8111\u6D77\u4E2D\u77AC\u95F4\u95EA\u8FC7\u7535\u89C6\u65C1\u5899\u58C1\u4E0A\u51FA\u73B0\u7684\u5E7B\u89C9
    \u2014\u20148203\u3002\u6211\u6000\u7740\u5FD0\u5FD1\u7684\u5FC3\u60C5\u8BD5\u7740\u8F93\u5165
    8203\uFF0C\u53EA\u542C\u9501 \u201C\u5494\u54D2\u201D \u4E00\u58F0\uFF0C\u95E8\u7F1D\u91CC\u900F\u51FA\u4E00\u4E1D\u5FAE\u5F31\u7684\u5149\u4EAE\uFF0C\u95E8\u7F13\u7F13\u5730\u6253\u5F00\u4E86\u3002    
    ---"
