--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: Lab203 to Boss Fight
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u6B63\u5F53\u6211\u8981\u6253\u5F00\u95E8\u7684\u65F6\u5019\uFF0C\u90A3\u4E2A\u4E00\u76F4\u7167\u987E\u6211\u7684\u533B\u751F\u51FA\u73B0\u5728\u6211\u7684\u8EAB\u540E\u3002"
  - "\u4ED6\u7684\u773C\u795E\u51B0\u51B7\u800C\u964C\u751F\uFF0C\u5634\u89D2\u6302\u7740\u4E00\u4E1D\u82E5\u6709\u82E5\u65E0\u7684\u51B7\u7B11\uFF0C\u548C\u5F80\u65E5\u91CC\u6E29\u548C\u7684\u6A21\u6837\u5224\u82E5\u4E24\u4EBA\u3002"
  - "\u201C\u4F60\u7EC8\u4E8E\u6765\u4E86\u3002\u201D \u4ED6\u7684\u58F0\u97F3\u4F4E\u6C89\u800C\u6C99\u54D1\uFF0C\u4EFF\u4F5B\u4ECE\u53E6\u4E00\u4E2A\u4E16\u754C\u4F20\u6765\uFF0C\u201C\u4F60\u4EE5\u4E3A\u81EA\u5DF1\u80FD\u9003\u51FA\u53BB\u5417\uFF1F\u592A\u5929\u771F\u4E86\u3002\u201D"
  - "\u6211\u63E1\u7D27\u624B\u4E2D\u7684\u5B89\u5168\u9524\uFF0C\u5F3A\u88C5\u9547\u5B9A\u5730\u95EE\u9053\uFF1A\u201C\u8FD9\u4E00\u5207\u5230\u5E95\u662F\u600E\u4E48\u56DE\u4E8B\uFF1F\u4F60\u4E3A\u4EC0\u4E48\u8981\u8FD9\u6837\u5BF9\u6211\uFF1F\u201D"
  - "\u533B\u751F\u6CA1\u6709\u56DE\u7B54\uFF0C\u53EA\u662F\u4F38\u51FA\u82CD\u767D\u7684\u624B\u6307\u5728\u865A\u7A7A\u4E2D\u8F7B\u8F7B\u4E00\u5212\uFF0C\u5730\u9762\u77AC\u95F4\u88C2\u5F00\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u5B54\u6D1E\u3002\u4F34\u968F\u7740\u9F7F\u8F6E\u8F6C\u52A8\u7684\u523A\u8033\u58F0\u54CD\uFF0C\u4E00\u4E2A\u4E2A\u5934\u6234\u767D\u5927\u8902\u3001\u9762\u5BB9\u626D\u66F2\u7684
    \u201C\u533B\u751F\u5206\u8EAB\u201D \u4ECE\u5B54\u6D1E\u4E2D\u5192\u4E86\u51FA\u6765\u3002\u8FD9\u4E9B\u5206\u8EAB\u7684\u773C\u775B\u6CDB\u7740\u5E7D\u7EFF\u7684\u5149\u8292\uFF0C\u5634\u89D2\u4EE5\u4E0D\u81EA\u7136\u7684\u5F27\u5EA6\u54A7\u5F00\uFF0C\u5634\u91CC\u53D1\u51FA\u673A\u68B0\u822C\u7684\u4F4E\u543C\u58F0\uFF0C\u8EAB\u4E0A\u8FD8\u7F20\u7ED5\u7740\u6ECB\u6ECB\u4F5C\u54CD\u7684\u9ED1\u8272\u7535\u7EBF\u3002"
  - "\u201C\u8FD9\u5C31\u662F\u4F60\u6253\u7834\u2018\u5B8C\u7F8E\u5B9E\u9A8C\u2019\u7684\u4EE3\u4EF7\u3002\u201D
    \u533B\u751F\u672C\u5C0A\u53CC\u81C2\u62B1\u80F8\uFF0C\u5C45\u9AD8\u4E34\u4E0B\u5730\u770B\u7740\u6211\uFF0C\u201C\u6BCF\u6D88\u706D\u4E00\u4E2A\u5206\u8EAB\uFF0C\u5C31\u79BB\u771F\u76F8\u66F4\u8FD1\u4E00\u6B65\uFF0C\u524D\u63D0\u662F\u4F60\u6491\u5F97\u5230\u90A3\u4E2A\u65F6\u5019\u3002\u201D
    \u8BDD\u97F3\u521A\u843D\uFF0C\u6700\u8FD1\u7684\u4E00\u4E2A\u5206\u8EAB\u7A81\u7136\u5F39\u5C04\u800C\u51FA\uFF0C\u624B\u4E2D\u4E0D\u77E5\u4F55\u65F6\u591A\u4E86\u4E00\u628A\u5BD2\u5149\u95EA\u95EA\u7684\u624B\u672F\u5200\uFF0C\u76F4\u523A\u6211\u7684\u54BD\u5589\u3002"
  - "\u6211\u4FA7\u8EAB\u7FFB\u6EDA\u8EB2\u5F00\u653B\u51FB\uFF0C\u6325\u52A8\u5B89\u5168\u9524\u7838\u5411\u5730\u9762\u3002\u201C\u7830\u201D
    \u7684\u4E00\u58F0\u95F7\u54CD\uFF0C\u4E00\u4E2A\u8BD5\u56FE\u4ECE\u80CC\u540E\u5077\u88AD\u7684\u5206\u8EAB\u88AB\u7838\u6210\u4E86\u96F6\u4EF6\uFF0C\u4F46\u66F4\u591A\u5206\u8EAB\u5982\u540C\u6F6E\u6C34\u822C\u6D8C\u6765\u3002\u8FD9\u4E9B\u5206\u8EAB\u884C\u52A8\u8BE1\u8C32\uFF0C\u65F6\u800C\u94BB\u5165\u5B54\u6D1E\u6D88\u5931\u4E0D\u89C1\uFF0C\u65F6\u800C\u4ECE\u610F\u60F3\u4E0D\u5230\u7684\u65B9\u5411\u94BB\u51FA\uFF0C\u6709\u51E0\u6B21\u5200\u950B\u51E0\u4E4E\u64E6\u7740\u6211\u7684\u76AE\u80A4\u5212\u8FC7\u3002"
  - "\u6FC0\u6218\u4E2D\uFF0C\u6211\u53D1\u73B0\u533B\u751F\u672C\u5C0A\u59CB\u7EC8\u7AD9\u5728\u84DD\u5149\u7B3C\u7F69\u7684\u5706\u5FC3\u5904\uFF0C\u53CC\u624B\u5728\u7A7A\u6C14\u4E2D\u4E0D\u65AD\u6BD4\u5212\uFF0C\u64CD\u63A7\u7740\u5206\u8EAB\u7684\u884C\u52A8\u8F68\u8FF9\u3002\u6BCF\u5F53\u4ED6\u6307\u5C16\u95EA\u70C1\u7EA2\u5149\uFF0C\u5206\u8EAB\u4EEC\u7684\u653B\u51FB\u5C31\u4F1A\u53D8\u5F97\u66F4\u52A0\u8FC5\u731B\u3002\u6211\u4E00\u8FB9\u8EB2\u907F\u7740\u5982\u96E8\u822C\u7684\u653B\u51FB\uFF0C\u4E00\u8FB9\u5BFB\u627E\u7740\u53CD\u51FB\u7684\u673A\u4F1A\u3002"
