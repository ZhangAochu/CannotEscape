  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: Final
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u6211\u8270\u96BE\u5730\u51FB\u8D25\u533B\u751F\u540E\uFF0C\u5468\u906D\u7A7A\u95F4\u5267\u70C8\u9707\u98A4\uFF0C\u5899\u9762\u5265\u843D\uFF0C\u5929\u82B1\u677F\u788E\u77F3\u5982\u96E8\u843D\u4E0B\u3002\u6211\u6342\u7740\u8111\u888B\uFF0C\u8DCC\u8DCC\u649E\u649E\u671D\u7740\u4EAE\u5149\u5904\u5954\u53BB\u3002\u5F53\u6211\u594B\u529B\u63A8\u5F00\u6700\u540E\u4E00\u6247\u95E8\uFF0C\u5F3A\u70C8\u7684\u5149\u7EBF\u77AC\u95F4\u5C06\u6211\u541E\u6CA1\u3002"
  - "\u7B49\u9002\u5E94\u5149\u7EBF\uFF0C\u5374\u53D1\u73B0\u81EA\u5DF1\u8EAB\u5904\u4E00\u4E2A\u964C\u751F\u7684\u7A7A\u95F4\u3002\u56DB\u5468\u662F\u51B0\u51B7\u7684\u91D1\u5C5E\u5899\u58C1\uFF0C\u5730\u9762\u4E0A\u6D41\u6DCC\u7740\u6697\u7EA2\u8272\u7684\u6DB2\u4F53\uFF0C\u6563\u53D1\u7740\u523A\u9F3B\u7684\u94C1\u9508\u5473\u3002\u6B63\u4E2D\u592E\u662F\u4E00\u5F20\u5DE8\u5927\u7684\u5B9E\u9A8C\u6905\uFF0C\u4E0A\u9762\u7ED1\u7740\u4E00\u4E2A\u5973\u5B69\uFF0C\u6B63\u662F\u6211\u81EA\u5DF1\u3002\u8EAB\u4E0A\u8FDE\u63A5\u7740\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u7EA2\u8272\u7BA1\u7EBF\uFF0C\u5EF6\u4F38\u5230\u623F\u95F4\u5404\u5904\u7684\u4EEA\u5668\u4E0A\uFF0C\u4EEA\u5668\u53D1\u51FA\u8BE1\u5F02\u7684\u55E1\u9E23\u3002"
  - "\u5934\u9876\u7684\u5C4F\u5E55\u4EAE\u8D77\uFF0C\u51FA\u73B0\u4E00\u4E2A\u6A21\u7CCA\u7684\u8EAB\u5F71\uFF0C\u58F0\u97F3\u4ECE\u56DB\u9762\u516B\u65B9\u4F20\u6765\uFF1A\u201C\u6B22\u8FCE\u6765\u5230\u771F\u76F8\u4E4B\u5730\uFF0C\u4F60\u4EE5\u4E3A\u6253\u8D25\u4ED6\u5C31\u80FD\u9003\u8131\uFF1F\u8FD9\u4E00\u5207\u4E0D\u8FC7\u662F\u6211\u4EEC\u5B9E\u9A8C\u7684\u4E00\u73AF\uFF0C\u4F60\u7684\u8BB0\u5FC6\u3001\u53CD\u6297\uFF0C\u90FD\u662F\u53EF\u89C2\u6D4B\u7684\u53D8\u91CF\u3002\u201D"
  - "\u6211\u770B\u7740\u88AB\u675F\u7F1A\u7684\u81EA\u5DF1\uFF0C\u8BB0\u5FC6\u788E\u7247\u75AF\u72C2\u95EA\u8FC7\uFF0C\u90A3\u4E9B\u68A6\u5883\u3001\u7ECF\u5386\uFF0C\u96BE\u9053\u90FD\u662F\u865A\u5047\u7684\uFF1F\u6211\u63E1\u7D27\u53CC\u62F3\uFF0C\u6012\u543C\uFF1A\u201C\u4E3A\u4EC0\u4E48\u8981\u8FD9\u4E48\u5BF9\u6211\uFF1F\u201D"
  - "\u5C4F\u5E55\u4E2D\u7684\u8EAB\u5F71\u53D1\u51FA\u523A\u8033\u7684\u7B11\u58F0\uFF1A\u201C\u4E3A\u4E86\u5B8C\u7F8E\u7684\u7CBE\u795E\u63A7\u5236\u5B9E\u9A8C\uFF0C\u4F60\u7684\u7279\u6B8A\u4F53\u8D28\u662F\u7EDD\u4F73\u6837\u672C\u3002\u4F60\u6240\u7ECF\u5386\u7684\u9003\u4EA1\u3001\u6218\u6597\uFF0C\u4E0D\u8FC7\u662F\u66F4\u6DF1\u5C42\u6B21\u7684\u5E7B\u89C9\u8BF1\u5BFC\uFF0C\u770B\u770B\u4F60\u5728\u4E0D\u540C\u523A\u6FC0\u4E0B\u7684\u7CBE\u795E\u53CD\u5E94\u6781\u9650\u3002\u201D"
  - "\u6211\u671B\u7740\u88AB\u7981\u9522\u7684\u8EAF\u4F53\uFF0C\u5FC3\u4E2D\u6D8C\u8D77\u65E0\u5C3D\u7684\u6124\u6012\u4E0E\u4E0D\u7518\u3002\u6211\u77E5\u9053\uFF0C\u771F\u6B63\u7684\u6218\u6597\u624D\u521A\u521A\u5F00\u59CB\uFF0C\u6211\u8981\u6253\u7834\u8FD9\u6700\u540E\u7684\u67B7\u9501\uFF0C\u6495\u5F00\u8FD9\u865A\u5E7B\u7684\u7262\u7B3C\uFF0C\u5BFB\u56DE\u771F\u6B63\u7684\u81EA\u5DF1\u2026\u2026"
  - "\u6E38\u620F\u7ED3\u675F\u3002"
