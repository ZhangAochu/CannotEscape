  m_Script: {fileID: 11500000, guid: 84645d09b07d3b54a898b706a29fe0f7, type: 3}
  m_Name: KnifeThrow
  m_EditorClassIdentifier: 
  dialogueList:
  - "\u8FDB\u5165\u623F\u95F4\u540E\uFF0C\u521A\u624D\u5728\u75C5\u623F\u770B\u5230\u7684\u533B\u751F\u53C8\u51FA\u73B0\u4E86\u3002"
  - "\u201C\u75C5\u4EBA\u2026\u2026 \u4E0D\u80FD\u79BB\u5F00\u2026\u2026\u201D \u5979\u7684\u58F0\u97F3\u6C99\u54D1\u5F97\u5982\u540C\u4ECE\u5589\u5499\u6DF1\u5904\u6324\u51FA\u6765\u7684\uFF0C\u5E26\u7740\u4E00\u79CD\u8BE1\u5F02\u7684\u8282\u594F\u611F\uFF0C\u201C\u8BB0\u5FC6\u2026\u2026
    \u4F1A\u5BB3\u4E86\u4F60\u2026\u2026\u201D"
  - "\u6211\u7D27\u7D27\u63E1\u4F4F\u9524\u5B50\uFF0C\u52AA\u529B\u538B\u5236\u4F4F\u5185\u5FC3\u7684\u6050\u60E7\uFF0C\u58F0\u97F3\u98A4\u6296\u7740\u95EE\u9053\uFF1A\u201C\u4F60\u2026\u2026
    \u4F60\u8BF4\u4EC0\u4E48\uFF1F\u4EC0\u4E48\u8BB0\u5FC6\uFF1F\u201D"
  - "\u5979\u6CA1\u6709\u56DE\u7B54\uFF0C\u53EA\u662F\u8111\u888B\u6B6A\u5F97\u66F4\u5389\u5BB3\u4E86\uFF0C\u53D1\u51FA\u4E00\u9635\u4F4E\u6C89\u7684\u7B11\u58F0\uFF0C\u5C31\u50CF\u98CE\u7B5D\u7EBF\u65AD\u88C2\u65F6\u53D1\u51FA\u7684\u56DE\u97F3\u3002\u201C\u6CBB\u7597\u2026\u2026
    \u8FD8\u6CA1\u7ED3\u675F\u2026\u2026\u201D \u5979\u7F13\u7F13\u4E3E\u8D77\u6CE8\u5C04\u5668\uFF0C\u4E00\u6B65\u6B65\u903C\u8FD1\u6211\uFF0C\u9488\u5934\u76F4\u76F4\u5730\u6307\u5411\u6211\u7684\u8138\u3002"
  - "\u5C31\u5728\u5979\u8BD5\u56FE\u9760\u8FD1\u6211\u7684\u90A3\u4E00\u523B\uFF0C\u6211\u773C\u89D2\u7684\u4F59\u5149\u77A5\u89C1\u5730\u4E0A\u6563\u843D\u7740\u51E0\u628A\u98DE\u5200\uFF0C\u5200\u67C4\u4E0A\u523B\u7740\u6A21\u7CCA\u4E0D\u6E05\u7684\u7B26\u53F7\uFF0C\u9690\u9690\u7EA6\u7EA6\u50CF\u662F\u98CE\u7B5D\u7684\u8F6E\u5ED3\u3002\u8FD9\u4E9B\u98DE\u5200\u4E0D\u77E5\u4ECE\u4F55\u800C\u6765\uFF0C\u4EFF\u4F5B\u662F\u8FD9\u4E2A\u623F\u95F4\u7279\u610F\u7559\u4E0B\u7684\u7EBF\u7D22\u3002\u6211\u6765\u4E0D\u53CA\u591A\u60F3\uFF0C\u4E00\u628A\u6293\u8D77\u98DE\u5200\uFF0C\u76F4\u89C9\u544A\u8BC9\u6211\uFF0C\u5FC5\u987B\u963B\u6B62\u5979\uFF01"
  - "\u8BF7\u5355\u51FB\u9F20\u6807\u5DE6\u952E\u6295\u63B7\u98DE\u5200\u4FDD\u62A4\u81EA\u5DF1\uFF01\uFF01\uFF01"
