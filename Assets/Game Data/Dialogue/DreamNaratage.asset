  dialogueList:
  - "\u523A\u76EE\u7684\u9633\u5149\u4E0B\uFF0C\u7A7F\u7740\u6E05\u51C9\u77ED\u8896\u7684\u7537\u4EBA\u8E72\u5750\u5728\u6211\u7684\u9762\u524D\u3002"
  - "\u4ED6\u8F7B\u8F7B\u5730\u7275\u8D77\u6211\u7684\u624B\uFF0C\u638C\u5FC3\u7684\u6E29\u5EA6\u8F7B\u6613\u5730\u900F\u8FC7\u6765\u3002"
  - "\u770B\u4E0D\u6E05\u9762\u524D\u7684\u4EBA\u7684\u8138\u3002"
  - "\u4ED6\u4E3E\u8D77\u6211\u8D8A\u8FC7\u4ED6\u7684\u5934\u9876\u8D70\u5230\u9662\u5899\u7684\u65C1\u8FB9\uFF0C\u6211\u5F97\u4EE5\u671B\u89C1\u5916\u9762\u7684\u4E16\u754C\u3002"
  - "\u8FDC\u5904\u7684\u5927\u697C\u50CF\u662F\u7D27\u5BC6\u6392\u5217\u7684\u6613\u62C9\u7F50\uFF0C\u4E0D\u7559\u4E00\u70B9\u7F1D\u9699\u3002"
  - "\u25A1\u25A1\u25A1\u25A1\uFF0C\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1"
